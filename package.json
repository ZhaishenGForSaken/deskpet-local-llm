{
  "name": "deskpet-local",
  "version": "2.0.0",
  "description": "连接本地大模型（Ollama / LM Studio / llama.cpp / vLLM）、会感知你在做什么的桌面宠物，基于 isKage/desk-llm-pet 改造",
  "keywords": [
    "desktop-pet",
    "electron",
    "ollama",
    "local-llm",
    "lm-studio",
    "llama-cpp",
    "chatbot"
  ],
  "main": "src/main/main.js",
  "author": "ZhaishenGForSaken",
  "contributors": [
    "isKage (https://github.com/isKage/desk-llm-pet)"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhaishenGForSaken/deskpet-local-llm.git"
  },
  "bugs": {
    "url": "https://github.com/ZhaishenGForSaken/deskpet-local-llm/issues"
  },
  "homepage": "https://github.com/ZhaishenGForSaken/deskpet-local-llm#readme",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:tools": "electron . --dev --devtools",
    "check": "node scripts/self-check.js",
    "check:renderer": "electron scripts/smoke-renderer.js",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac",
    "postinstall": "node scripts/setup-assets.js"
  },
  "dependencies": {
    "electron-store": "^8.1.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.deskpet.localllm",
    "productName": "DeskPet",
    "copyright": "MIT License - isKage, ZhaishenGForSaken",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSApplicationSupportsSecureRestorableState": true,
        "LSUIElement": false
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DeskPet",
      "uninstallDisplayName": "DeskPet"
    },
    "asar": true,
    "asarUnpack": []
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
